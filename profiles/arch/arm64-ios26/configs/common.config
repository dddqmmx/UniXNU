# Knobs of scripts/build-xnu-12377.sh. The xnu-10063 options (CONFIG_XNU_OWNER_*, CONFIG_XNU_NATIVE_UFS,
# ...) do not apply to this build.
CONFIG_XNU_BUILD_SCRIPT="build-xnu-12377.sh"
# Register the real source crypto and pthread providers through XNU's versioned shims.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
# Link the real device-tree platform expert and the GICv3 boot CPU provider into XNU 12377.
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
# No Raspberry Pi local-controller timer routing: the board's GICv3 provider owns the timer.
CONFIG_XNU_NATIVE_ARCH_TIMER=y
# ARMv8.1+ cores implement PAN (see the board defconfig for the SCTLR_EL1.SPAN reasoning).
CONFIG_XNU_NATIVE_PAN=y
# Panic log from the device tree's pram region, not the Raspberry Pi address.
CONFIG_XNU_DT_PANIC_REGION=y
# Off until a trust cache for the 23F84 image is built.
CONFIG_XNU_TRUST_CACHE_RUNTIME=n
